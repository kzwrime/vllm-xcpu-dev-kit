# Host paths for the local 146 machine. Run Compose with:
# docker compose --env-file .env.146 up -d
HF_CACHE_HOST_PATH=/home/wzk/weights/huggingface
MODELSCOPE_CACHE_HOST_PATH=/home/wzk/weights/modelscope
SHARED_HOST_PATH=/home/wzk/docker_shared
DEV_CODE_HOST_PATH=/home/wzk/docker_workspace
CACHE_HOST_PATH=/data/nvme-raid0/wzk/docker_cache
SHM_HOST_PATH=/dev/shm

# Reuse an externally-created Docker network. Its subnet must be
# ${VLLM_SUBNET_PREFIX}.0/24, with .11 through .18 available for these nodes.
VLLM_NETWORK_NAME=wzk-vllm-xcpu-03-net
VLLM_SUBNET_PREFIX=172.30.3
CONTAINER_NAME_PREFIX=wzk-vllm-xcpu-03
IMAGE_NAME=wzk-vllm-xcpu-dev:ubuntu24.04
