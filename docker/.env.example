# Copy to .env and choose host paths for this developer/machine.
HF_CACHE_HOST_PATH=/path/to/weights/huggingface
MODELSCOPE_CACHE_HOST_PATH=/path/to/weights/modelscope
SHARED_HOST_PATH=/path/to/shared-data
DEV_CODE_HOST_PATH=/path/to/development-code
# Normally leave this unchanged.
SHM_HOST_PATH=/dev/shm
